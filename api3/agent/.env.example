# SupplierPulse+ agent (api3/agent/pulse_agent.py). Copy to api3/agent/.env; never commit .env.
AGENT_PROFILE=demo                 # demo (minutes) or prod (days), see docs/agent.md
PULSE_PLUS_ADDRESS=                # SupplierPulsePlus on Ethereum Sepolia (set at C3)
# Comma-separated, tried in order. Tenderly rate-limits bursts; publicnode is the fallback.
EVM_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co
AGENT_PRIVATE_KEY=                 # the agent wallet: Sepolia ETH for gas. Not the buyer.
PAYER_PRIVATE_KEY=                 # Base Sepolia wallet with aUSD for the $0.01 checks (used by FETCH_CMD)
FETCH_CMD=api3/scripts/fetch-evidence.sh   # api3/scripts/fetch-local.sh on the local test chain

# Optional overrides of the profile (docs/agent.md has the defaults)
# TICK_SECONDS=30
# DUE_LEAD_SECONDS=300
# MONITOR_SECONDS_STANDARD=600
# MONITOR_SECONDS_TRUSTED=1800
# MONITOR_SECONDS_PREMIUM=3600
# DAILY_BUDGET_USD=1.00
# DUE_RESERVE_USD=0.20
# MAX_FETCHES_PER_TICK=3
# MAX_FETCH_ATTEMPTS=3
# MAX_GAS_PRICE_GWEI=50
# FETCH_COST_USD=0.01
