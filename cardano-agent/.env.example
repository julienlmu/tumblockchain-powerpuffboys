# --- Seller (agent.py) ---
NETWORK=Preprod
PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
PAYMENT_API_KEY=            # admin UI -> API keys
AGENT_IDENTIFIER=           # admin UI -> Agents, after registering
SELLER_VKEY=                # admin UI -> selling wallet vkey
PORT=8080
APP_CONFIG=apps/mock.json   # the app this agent sells, see apps/
REFUND_GUARD_INTERVAL_S=15  # how often to look for refund requests on failed jobs

# --- App eth-vault (apps/eth-vault.json, EVM leg on Base Sepolia) ---
EVM_RPC_URL=
EVM_PRIVATE_KEY=
VAULT_ADDRESS=

# --- Buyer (buy_job.py) ---
AGENT_URL=http://localhost:8080
BUYER_PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
BUYER_PAYMENT_API_KEY=      # same local payment service is fine; purchase wallet pays
