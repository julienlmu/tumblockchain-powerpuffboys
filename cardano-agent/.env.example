# --- Seller (agent.py) ---
NETWORK=Preprod
PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
PAYMENT_API_KEY=            # admin UI -> API keys
AGENT_IDENTIFIER=           # admin UI -> Agents, after registering
SELLER_VKEY=                # admin UI -> selling wallet vkey
PORT=8080
APP_CONFIG=apps/mock.json   # the app this agent sells: supplier-pulse, supplier-pulse-sim, eth-vault or mock (apps/)
REFUND_GUARD_INTERVAL_S=15  # how often to look for refund requests on failed jobs
PAYMENT_SOURCE_INDEX=0      # which payment option of the V2 registration to price jobs with
# Job deadlines in minutes. Empty: SDK/service defaults (pay 12 h, result 24 h,
# unlock 6 h after that). The values below let the escrow pay the seller ~36 min after a job.
PAY_BY_MINUTES=10
SUBMIT_RESULT_MINUTES=20
UNLOCK_AFTER_RESULT_MINUTES=16
DISPUTE_AFTER_UNLOCK_MINUTES=16

# --- App eth-vault (apps/eth-vault.json, EVM leg on Base Sepolia) ---
EVM_RPC_URL=
EVM_PRIVATE_KEY=
VAULT_ADDRESS=

# --- Buyer (buy_job.py) ---
AGENT_URL=http://localhost:8080
BUYER_PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
BUYER_PAYMENT_API_KEY=      # same local payment service is fine; purchase wallet pays
